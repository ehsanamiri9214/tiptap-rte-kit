{
  "name": "tiptap-rte-kit",
  "version": "0.2.0",
  "description": "A batteries-included Tiptap rich text editor + read-only renderer + toolbar, built on @heroui/react. Extracted from Bridgeto so it can be reused across projects.",
  "license": "MIT",
  "author": "Ehsan Amiri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehsanamiri9214/tiptap-rte-kit.git"
  },
  "homepage": "https://github.com/ehsanamiri9214/tiptap-rte-kit#readme",
  "bugs": {
    "url": "https://github.com/ehsanamiri9214/tiptap-rte-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@heroui/react": ">=3.0.0",
    "@heroui/styles": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-highlight": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-subscript": "^3.26.1",
    "@tiptap/extension-superscript": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-youtube": "^3.26.1",
    "@tiptap/extensions": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "react-icons": "^5.7.0",
    "tiptap-extension-resize-image": "^1.4.0"
  },
  "devDependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "tiptap",
    "rich-text-editor",
    "rte",
    "react",
    "heroui",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
